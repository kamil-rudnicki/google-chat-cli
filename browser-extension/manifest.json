{
  "manifest_version": 3,
  "name": "gchat Home",
  "version": "0.1.0",
  "description": "Read the Google Chat Home unread list from gchat.",
  "key": "",
  "permissions": ["nativeMessaging", "scripting"],
  "host_permissions": ["https://chat.google.com/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "Reconnect gchat Home"}
}
